  "map_present": {
    "$defs": {
      "RasterReference": {
        "additionalProperties": false,
        "properties": {
          "output_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Output Id",
            "type": "string"
          },
          "view_id": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "title": "View Id",
            "type": "string"
          }
        },
        "required": [
          "output_id",
          "view_id"
        ],
        "title": "RasterReference",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "rasters": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/RasterReference"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Raster results and explicit view IDs to show. Supply rasters or image_ids, exclusively.",
        "title": "Rasters"
      },
      "image_ids": {
        "anyOf": [
          {
            "items": {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Image IDs from search results to add as layers. Supply image_ids or rasters, exclusively.",
        "title": "Image Ids"
      },
      "open_map": {
        "default": true,
        "title": "Open Map",
        "type": "boolean"
      },
      "focus": {
        "default": true,
        "title": "Focus",
        "type": "boolean"

        "title": "RasterPresentation",
        "type": "object"
      },
      "RasterView": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "group": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Group",
            "type": "string"
          },
          "bands": {
            "items": {
              "minimum": 1,
              "type": "integer"
            },
            "minItems": 1,
            "title": "Bands",
            "type": "array"
          },
          "style": {
            "discriminator": {
              "mapping": {
                "classified": "#/$defs/ClassifiedStyle",
                "continuous": "#/$defs/ContinuousStyle",
                "rgb": "#/$defs/RGBStyle"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ContinuousStyle"
              },
              {
                "$ref": "#/$defs/RGBStyle"
              },
              {
                "$ref": "#/$defs/ClassifiedStyle"
              }
            ],
            "title": "Style"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "group",
          "bands",
          "style"
        ],
        "title": "RasterView",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "title": {
        "maxLength": 120,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "code": {
        "description": "OGE Python SDK code that explicitly loads its inputs; compose operators then export exactly one Coverage with result.export(name).",
        "maxLength": 12000,
        "minLength": 1,
        "title": "Code",
        "type": "string"
      },
      "crs": {
        "pattern": "^EPSG:[0-9]{4,6}$",
        "title": "Crs",
        "type": "string"
      },
      "scale": {
        "exclusiveMinimum": 0,
        "maximum": 100000,
        "title": "Scale",
        "type": "number"
      },
      "presentation": {
        "$ref": "#/$defs/RasterPresentation",
        "description": "Describe every exported band in order and declare views with explicit band selections, styles and a default view. The same contract applies to any band count and RGB."
      }
    },
    "required": [
      "title",
      "code",
      "crs",
      "scale",
      "presentation"
    ],
    "title": "ExecuteCodeArguments",
    "type": "object"
  },

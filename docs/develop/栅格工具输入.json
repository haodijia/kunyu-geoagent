            "type": "string"
          },
          "percentiles": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Percentiles",
            "type": "array"
          }
        },
        "required": [
          "method",
          "percentiles"
        ],
        "title": "PercentileStretch",
        "type": "object"
      },
      "RGBStyle": {

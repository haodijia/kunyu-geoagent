              "viridis",
              "blue",
              "gray"
            ],
            "title": "Color Ramp",
            "type": "string"
          },
          "stretch": {
            "discriminator": {
              "mapping": {
                "percentile": "#/$defs/PercentileStretch",
                "range": "#/$defs/RangeStretch"
              },
              "propertyName": "method"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RangeStretch"
              },
              {
                "$ref": "#/$defs/PercentileStretch"
              }
            ],
            "title": "Stretch"
          }
        },
        "required": [
          "type",
          "color_ramp",
          "stretch"
        ],
        "title": "ContinuousStyle",
        "type": "object"
      },
      "PercentileStretch": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "const": "percentile",

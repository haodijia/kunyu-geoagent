            "title": "Stretch"
          }
        },
        "required": [
          "type",
          "stretch"
        ],
        "title": "RGBStyle",
        "type": "object"
      },
      "RangeStretch": {
        "additionalProperties": false,
        "properties": {
          "method": {
            "const": "range",
            "title": "Method",
            "type": "string"
          },
          "ranges": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "minItems": 1,
            "title": "Ranges",
            "type": "array"
          }
        },
        "required": [
          "method",
          "ranges"
